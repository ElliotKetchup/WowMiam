{
  "expo": {
    "name": "Wow Miam",
    "slug": "wowmiam",
    "owner": "elliota-org",
    "version": "0.3.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "wowmiam",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4EFF3",
    "ios": {
      "bundleIdentifier": "com.elliotketchup.wowmiam",
      "supportsTablet": false
    },
    "android": {
      "package": "com.elliotketchup.wowmiam",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#2A1530",
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4EFF3",
          "image": "./assets/brand/splash.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Wow Miam a besoin de tes photos pour ajouter l’image d’un plat.",
          "cameraPermission": "Wow Miam a besoin de l’appareil photo pour photographier tes plats."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "updates": {
      "url": "https://u.expo.dev/f735625b-b0fa-4d8a-a80e-ffb8b17e3cde",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "extra": {
      "eas": {
        "projectId": "f735625b-b0fa-4d8a-a80e-ffb8b17e3cde"
      }
    }
  }
}
